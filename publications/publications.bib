 abstract = {},
 author = {Rangel Pinagé, Ekena and M. Bell, David and Longo, Marcos and Gao, Sicong and Keller, Michael and Silva, Carlos A. and Ometto, Jean P. and Köhler, Philipp and Frankenberg, Christian and Huete, Alfredo},
 doi = {10.1016/j.rse.2022.112998},
