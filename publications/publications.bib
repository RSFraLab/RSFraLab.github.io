 author = {Wu, Genghong and Jiang, Chongya and Kimm, Hyungsuk and Wang, Sheng and Bernacchi, Carl and Moore, Caitlin E. and Suyker, Andy and Yang, Xi and Magney, Troy and Frankenberg, Christian and Ryu, Youngryel and Dechant, Benjamin and Guan, Kaiyu},
 doi = {10.1016/j.rse.2022.113104},
