 abstract = {},
 author = {Mohammed, Gina H. and Colombo, Roberto and Middleton, Elizabeth M. and Rascher, Uwe and van der Tol, Christiaan and Nedbal, Ladislav and Goulas, Yves and Pérez-Priego, Oscar and Damm, Alexander and Meroni, Michele and Joiner, Joanna and Cogliati, Sergio and Verhoef, Wouter and Malenovský, Zbyněk and Gastellu-Etchegorry, Jean-Philippe and Miller, John R. and Guanter, Luis and Moreno, Jose and Moya, Ismael and Berry, Joseph A. and Frankenberg, Christian and Zarco-Tejada, Pablo J.},
